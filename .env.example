# Copiar a .env en desarrollo. Nunca publicar credenciales reales.
PORT=4000
APP_ORIGIN=http://localhost:3000
# Alternativa: PGHOST, PGPORT, PGDATABASE, PGUSER y PGPASSWORD del entorno.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/tickettrade
# Base/proyecto DIFERENTE. La semilla solo se instala aquí; nunca en DATABASE_URL.
DATABASE_URL_DEMO=postgresql://USUARIO:CONTRASENA@localhost:5432/tickettrade_demo
# La aplicación conectada es la predeterminada. ?modo=local abre el prototipo anterior.
VITE_MODO_DATOS=api
# Habilita ?demo=1 únicamente si hay una conexión independiente configurada.
TT_DEMO=1
# Para la práctica local: muestra códigos de confirmación/recuperación generados.
TT_MOSTRAR_CODIGOS=1
# Opcional si psql no está en PATH (npm run db:ver).
# PSQL_PATH=D:/PostgreSQL/bin/psql.exe
