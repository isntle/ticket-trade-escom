# Configuración de Entorno Institucional — Ticket Trade ESCOM IPN
VITE_NOMBRE_SISTEMA="Ticket Trade ESCOM"
APP_URL="MY_APP_URL"

# Backend / Base de Datos PostgreSQL
PORT=4000
DATABASE_URL="postgresql://tickettrade_app:TU_PASSWORD@localhost:5432/tickettrade"
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="tickettrade"
PGUSER="tickettrade_app"
PGPASSWORD="TU_PASSWORD"
PGOPTIONS="-c search_path=ticket_trade,public"
SESSION_SECRET="tu_secreto_de_sesion_aqui"
